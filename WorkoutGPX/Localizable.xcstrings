          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez vos exports sur Mac, iPhone et iPad : la pente en couleur, cardio et puissance tracés, temps en mouvement et intermédiaires. Gratuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tus exportaciones en Mac, iPhone y iPad: la pendiente en color, pulso y potencia en gráfica, tiempo en movimiento y parciales. Gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したファイルをMac・iPhone・iPadで開けます。勾配は色で、心拍とパワーはグラフで、移動時間とスプリットも。無料。"
