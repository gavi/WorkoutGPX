    "More detail shows every point in the elevation chart; less is faster on very long routes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Detail zeigt jeden Punkt im Höhendiagramm; weniger ist bei sehr langen Routen schneller."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de détail affiche chaque point du graphique d'altitude ; moins est plus rapide sur les très longs parcours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más detalle muestra cada punto en la gráfica de altitud; menos es más rápido en rutas muy largas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細度を上げると標高グラフにすべての点を表示します。下げると長いルートで速くなります。"
          }
        }
      }
    },
